[
    {
        "label": "build-debug-win32-d3d11",
        "cmd": "odin run ./build_scripts -collection:topdown_game=. -out:./build_scripts/build.exe -- --debug --d3d11"
    },
    {
        "label": "build-run-debug-win32-d3d11",
        "cmd": "odin run ./build_scripts -collection:topdown_game=. -out:./build_scripts/build.exe -- --debug --d3d11 && .\\build\\debug\\main.exe"
    },
    {
        "label": "build-release-win32-d3d11",
        "cmd": "odin run ./build_scripts -collection:topdown_game=.  -out:./build_scripts/build.exe -- --release --d3d11"
    },
    {
        "label": "build-run-release-win32-d3d11",
        "cmd": "odin run ./build_scripts -collection:topdown_game=.  -out:./build_scripts/build.exe -- --release --d3d11 && build\\release\\main.exe"
    },
    {
        "label": "compile-shaders",
        "cmd": "odin run ./build_scripts -collection:topdown_game=. -out:./build_scripts/build.exe -- --shader-only"
    }
]
